; Astral Veil: The Summoned Thirty — editable Godot source
config_version=5

[application]
config/name="Astral Veil: The Summoned Thirty"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="An original, compact, complete three-act party action RPG."

[autoload]
DB="*res://systems/database.gd"
State="*res://systems/state.gd"
Sound="*res://systems/sound.gd"

[display]
window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.022,0.039,0.059,1)

[audio]
driver/enable_input=false

[gui]
theme/default_font_multichannel_signed_distance_field=true

[physics]
common/physics_ticks_per_second=60
